# `pnpm run setup:local` generates a random JWT_SECRET in ignored .env files.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Optional: complete all these settings to enable Access-backed MCP.
# APP_ORIGIN=https://app.example.com
# MCP_ORIGIN=https://mcp.example.com
# ACCESS_ISSUER=https://team.cloudflareaccess.com
# ACCESS_JWKS_URL=https://team.cloudflareaccess.com/cdn-cgi/access/certs
# ACCESS_BROWSER_AUDIENCE=replace-with-browser-application-audience
# ACCESS_MCP_AUDIENCE=replace-with-mcp-application-audience
