{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals",
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "apps",
    "modules",
    "platform",
    "shared-kernel",
    "tests",
    "vitest.config.ts",
    "drizzle.config.ts",
    "dev"
  ]
}
